# This public URL is embedded in canonical URLs during the image build.
NEXT_PUBLIC_SITE_URL=https://sofanmore.co.uk

# MongoDB (MongoDB Atlas is recommended for a single-server deployment).
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
MONGODB_DB=sofanmore

# Generate independent secrets with: openssl rand -base64 48
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional comma-separated additional origins allowed to submit forms.
ALLOWED_FORM_ORIGINS=

# AWS S3 or another S3-compatible object store.
UPLOAD_BUCKET=replace-with-bucket-name
UPLOAD_REGION=eu-west-2
UPLOAD_ENDPOINT=
UPLOAD_ACCESS_KEY_ID=replace-with-access-key
UPLOAD_SECRET_ACCESS_KEY=replace-with-secret-key
UPLOAD_PUBLIC_BASE_URL=https://replace-with-public-file-host
UPLOAD_FORCE_PATH_STYLE=false
